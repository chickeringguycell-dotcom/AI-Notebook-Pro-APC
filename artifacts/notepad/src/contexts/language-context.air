meta !language = "AetherPrime-AIR-IR"
meta !sovereign_owner = "Viper Studios Technologies"
meta !source = "contexts/language-context.tsx"

module @ViperStudios.MyAiNotebook.contexts_language_context {
  func @LangCode() -> !air.any {
  entry:
    %v = call @air.exec.symbol("LangCode") : (!air.str) -> !air.any
    ret %v
  }
  func @LANGUAGES() -> !air.any {
  entry:
    %v = call @air.exec.symbol("LANGUAGES") : (!air.str) -> !air.any
    ret %v
  }
  func @LanguageProvider() -> !air.any {
  entry:
    %v = call @air.exec.symbol("LanguageProvider") : (!air.str) -> !air.any
    ret %v
  }
  func @useLang() -> !air.any {
  entry:
    %v = call @air.exec.symbol("useLang") : (!air.str) -> !air.any
    ret %v
  }
}
