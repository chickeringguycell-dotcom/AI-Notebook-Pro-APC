module @ViperStudios.AetherPrime.MyAiNotebook.not_found {
  meta !language = "AetherPrime-AIR-IR"
  meta !source = "pages/not-found.tsx"

  func @entry_not_found() -> !air.status {
  entry():
    %ok = air.constant 0 : !air.status
    air.return %ok : !air.status
  }
}
