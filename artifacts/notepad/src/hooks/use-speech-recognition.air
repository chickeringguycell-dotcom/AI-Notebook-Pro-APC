module @ViperStudios.AetherPrime.MyAiNotebook.use_speech_recognition {
  meta !language = "AetherPrime-AIR-IR"
  meta !source = "hooks/use-speech-recognition.ts"

  func @entry_use_speech_recognition() -> !air.status {
  entry():
    %ok = air.constant 0 : !air.status
    air.return %ok : !air.status
  }
}
