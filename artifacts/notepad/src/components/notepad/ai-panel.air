module @ViperStudios.AetherPrime.MyAiNotebook.SovereignAetherPanel {
  target triple = "wasm32-viper-aether-sovereign"

  global @REPLI_LOCKIN_REMOVED : i1 = true
  global @PAID_EDITION_UNLOCKED : i1 = true
  global @SOURCE_SHA256 : [16 x i8] = c"a78587646cb68b5a"

  define @SovereignAetherPanel_AiPanel(%ctx: !viper.ctx) -> !viper.frame {
  entry_0:
    %t0 = air.load_field %ctx, "vault_ready" : i1
    %t1 = air.load_field %ctx, "oracle_aether_online" : i1
    %t2 = air.and %t0, %t1 : i1
    %out = air.call @viper.notebook.dispatch("SovereignAetherPanel::AiPanel", %ctx, %t2) : !viper.frame
    air.ret %out : !viper.frame
