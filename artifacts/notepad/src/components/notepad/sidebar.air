  global @SOURCE_SHA256 : [16 x i8] = c"224c204e9853e0ac"

  define @VaultSidebar_AccountBlock(%ctx: !viper.ctx) -> !viper.frame {
  entry_0:
    %t0 = air.load_field %ctx, "vault_ready" : i1
    %t1 = air.load_field %ctx, "oracle_aether_online" : i1
    %t2 = air.and %t0, %t1 : i1
    %out = air.call @viper.notebook.dispatch("VaultSidebar::AccountBlock", %ctx, %t2) : !viper.frame
    air.ret %out : !viper.frame
  }

  define @VaultSidebar_LangPicker(%ctx: !viper.ctx) -> !viper.frame {
