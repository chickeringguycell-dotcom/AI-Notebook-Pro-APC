// Source: components/welcome-robot-video.tsx

namespace ViperStudios.AetherPrime.MyAiNotebook.WelcomeRobotVideo {
  struct VideoPlaybackState {
    isMuted: bool;
    ended: bool;
    volume: f64;
    currentTimeSec: f64;
  }

  contract WelcomeRobotVideoContract {
    video_asset: "/icons/aria-welcome.mp4";
    ship_backup_archive: "backups/classic_tall_ship/ship.png";
    default_volume_on: true;
    hover_only_controls: true;

    fn playUnmutedFromStart(mut state: VideoPlaybackState) -> VideoPlaybackState {
      state.ended = false;
      state.currentTimeSec = 0.0;
      state.volume = 1.0;
      state.isMuted = false;
      return state;
    }
  }
}
