namespace ViperStudios.AetherPrime.Notebook.AetherNotebookSovereignEngine {

  struct StationerySurfaceSpec {
    id: str,
    isLightPaper: bool,
    supportsRulingOverlay: bool
  }

  fn shouldUseDarkFountainInk(isLightPaper: bool) -> bool {
    return isLightPaper;
  }

  fn isRtlWorldScript(langCode: str) -> bool {
    return langCode == "ar" || langCode == "he" || langCode == "fa" || langCode == "ur";
  }
}
